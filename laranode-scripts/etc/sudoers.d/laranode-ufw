# Laranode firewall (UFW) sudoers drop-in
# Mode 0440. Managed by laranode-installer.sh — do not edit manually.
# The firewall Actions call the allowlisted wrapper laranode-ufw.sh
# (status / status-numbered / show-added / allow / deny / delete / enable /
# disable). Grant www-data NOPASSWD for that wrapper only — never for
# /usr/sbin/ufw itself, so `ufw reset` / `ufw disable` cannot be run as
# www-data outside the panel's own subcommand vocabulary.
# requiretty stays off so it works from the web SAPI (no controlling tty).
# Admin-gated in-app; enabling is protected by the lockout guard.

Defaults!/home/laranode_ln/panel/laranode-scripts/bin/laranode-ufw.sh !requiretty
www-data ALL=(ALL) NOPASSWD: /home/laranode_ln/panel/laranode-scripts/bin/laranode-ufw.sh
