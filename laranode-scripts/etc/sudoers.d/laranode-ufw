# Laranode firewall (UFW) sudoers drop-in
# Mode 0440. Managed by laranode-installer.sh — do not edit manually.
# The firewall Actions call ONE root-owned wrapper, which accepts only the sub-commands
# status / status-numbered / show-added / enable / disable / allow / deny / delete and
# validates every rule token. There is deliberately no grant for the ufw binary itself:
# `NOPASSWD: /usr/sbin/ufw` let a compromised web user pass any option.
# Admin-gated in-app; enabling is protected by the lockout guard.

Defaults!/usr/local/lib/laranode/bin/laranode-ufw.sh !requiretty
www-data ALL=(ALL) NOPASSWD: /usr/local/lib/laranode/bin/laranode-ufw.sh
